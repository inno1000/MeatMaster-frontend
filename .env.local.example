# Origine du backend Laravel (sans slash final, sans chemin /api/...).
NEXT_PUBLIC_API_URL=https://boucherie-api.onrender.com

# Préfixe des routes REST après l’origine (défaut /api/v1 si non défini).
# Exemples : /api/v1, /api/v2
NEXT_PUBLIC_API_PREFIX=/api/v1

# Mot de passe provisoire pour les comptes créés par l’admin (≥ 8 caractères).
# Si la connexion utilise encore ce mot de passe, l’utilisateur doit le changer avant le reste de l’app.
# Sans cette variable, une valeur par défaut de développement est utilisée (voir src/lib/default-password.ts).
NEXT_PUBLIC_DEFAULT_NEW_USER_PASSWORD=
