{
  "name": "MeatMaster",
  "version": "1.1.0",
  "private": true,
  "author": "CodedThemes",
  "scripts": {
    "dev": "npm run dev --prefix ./next",
    "build": "npm run build --prefix ./next",
    "start": "npm run start --prefix ./next",
    "lint": "npm run lint --prefix ./next",
    "mobile:android:branding": "node scripts/generate-android-branding.mjs",
    "build:mobile": "npm run build --prefix ./next && npx cap sync android",
    "android:assemble": "npm run build:mobile && android\\gradlew.bat assembleDebug",
    "android:assemble:release": "npm run build:mobile && android\\gradlew.bat assembleRelease",
    "vue:dev": "vite",
    "vue:build": "vue-tsc --noEmit && vite build",
    "vue:build-stage": "vue-tsc --noEmit && vite build --base=/vue/free/stage/",
    "vue:build-prod": "vue-tsc --noEmit && vite build --base=/vue/free/",
    "vue:preview": "vite preview --port 5050",
    "vue:typecheck": "vue-tsc --noEmit",
    "vue:lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "vue:build:mobile": "vite build --mode development && npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "npx cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.1.0",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/haptics": "^7.0.2",
    "@capacitor/keyboard": "^7.0.3",
    "@capacitor/status-bar": "^7.0.3",
    "@codekraft-studio/vue-record": "^0.0.3",
    "@tiptap/starter-kit": "2.2.2",
    "@tiptap/vue-3": "2.2.2",
    "@tsconfig/node20": "^20.1.2",
    "apexcharts": "3.45.2",
    "axios": "1.6.7",
    "axios-mock-adapter": "^1.22.0",
    "chance": "1.1.11",
    "date-fns": "3.3.1",
    "lodash": "4.17.21",
    "pinia": "2.1.7",
    "remixicon": "4.1.0",
    "vee-validate": "4.12.5",
    "vite-plugin-vuetify": "2.0.1",
    "vue": "3.4.19",
    "vue-audio-recorder": "^3.0.1",
    "vue-router": "4.2.5",
    "vue-tabler-icons": "2.21.0",
    "vue3-apexcharts": "1.5.2",
    "vue3-perfect-scrollbar": "1.6.1",
    "vue3-print-nb": "0.1.4",
    "vue3-storage": "^0.1.11",
    "vue3-toastify": "^0.2.1",
    "vuetify": "3.5.4",
    "vuetify-audio": "^0.3.3",
    "webpack-plugin-vuetify": "^3.0.1",
    "yup": "1.3.3"
  },
  "devDependencies": {
    "@mdi/font": "7.4.47",
    "@resvg/resvg-js": "^2.6.2",
    "@rushstack/eslint-patch": "1.7.2",
    "@types/chance": "1.1.6",
    "@types/node": "^20.11.18",
    "@vitejs/plugin-vue": "5.0.4",
    "@vue/eslint-config-prettier": "9.0.0",
    "@vue/eslint-config-typescript": "12.0.0",
    "@vue/tsconfig": "0.5.1",
    "eslint": "8.56.0",
    "eslint-plugin-vue": "9.21.1",
    "jimp": "^1.6.1",
    "prettier": "3.2.5",
    "sass": "1.70.0",
    "sass-loader": "14.1.0",
    "typescript": "5.3.3",
    "vite": "5.1.2",
    "vue-cli-plugin-vuetify": "2.5.8",
    "vue-tsc": "1.8.27"
  }
}
