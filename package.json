{
  "name": "meatmaster",
  "version": "1.2.0",
  "private": true,
  "description": "MeatMaster — Next.js + Capacitor Android",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "mobile:android:branding": "node scripts/generate-android-branding.mjs",
    "build:mobile": "npm run build && npx cap sync android",
